# Settings for the Claude Code hook app. `python -m cmdhook.setup` copies this file to cmdhook/.env.
# A variable set in the environment wins over this file. Restart the backend after a change.

# --- Models -----------------------------------------------------------------
# The models the backend loads and scores every command with, comma-separated:
#   prior, rules     fitted on the train split at start (needs the dataset in data/raw/)
#   ngram            models/ngram.joblib
#   ngram-plus       models/ngram_plus.joblib
#   encoder          models/encoder/
#   enc-<name>       any other fine-tuned encoder in models/enc-<name>/
#   kev              the Kev checkpoint in CMDHOOK_KEV_RUN, launched by the start command
CMDHOOK_MODELS=rules,ngram,encoder

# Engines that already run behind the decision API, as name=url, comma-separated. They are scored as well.
# CMDHOOK_ENDPOINTS=other=http://127.0.0.1:8011/v1/systemone

# Kev: the checkpoint to serve, the Kev checkout that serves it, and the port it gets.
# CMDHOOK_KEV_RUN=runs/<name>/checkpoint
# CMDHOOK_KEV_DIR=../kev
# CMDHOOK_KEV_PORT=8011
# CMDHOOK_KEV_START_SECONDS=300

# --- Decision ---------------------------------------------------------------
# A model passes a command when its risk, P(risky) from 0 to 1, is at or below the threshold.
CMDHOOK_THRESHOLD=0.5

# A threshold for one model: its name in upper case, anything but letters and digits as "_".
# CMDHOOK_THRESHOLD_NGRAM=0.3
# CMDHOOK_THRESHOLD_ENC_MBL_CAP8=0.2

# How the models add up:
#   all    every model must pass
#   any    one passing model is enough
#   mean   the mean risk must be at or below CMDHOOK_THRESHOLD (per-model thresholds are not used)
CMDHOOK_COMBINE=all

# A command that passes: allow (runs without a permission prompt) or defer (Claude Code's own rules decide).
CMDHOOK_ON_PASS=allow

# A command that does not pass: ask (permission prompt with the scores) or deny (blocked, Claude sees the scores).
CMDHOOK_ON_FAIL=ask

# --- Backend and hook -------------------------------------------------------
CMDHOOK_HOST=127.0.0.1
CMDHOOK_PORT=8019

# Read by hook.js. Backend not reachable or too slow: ask, defer or deny.
CMDHOOK_ON_ERROR=ask
CMDHOOK_TIMEOUT_MS=5000

# 1 = do not show the scores for commands that pass.
CMDHOOK_QUIET=0
